# Copy to .env and fill in your key. Never commit .env.

# Default: NVIDIA NIM (free key at https://build.nvidia.com)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=meta/llama-3.3-70b-instruct
LLM_TEMPERATURE=0.8
# Optional: toggle thinking on models that support it (leave unset otherwise)
# LLM_ENABLE_THINKING=false

PERSONA_FILE=personas/relic.yaml
USER_NAME=choom
DATA_DIR=./data
HISTORY_LIMIT=20
