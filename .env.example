# Copy to .env and fill in your key. Never commit .env.

# Default: NVIDIA NIM (free key at https://build.nvidia.com)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_TEMPERATURE=0.8
# Turns reasoning off for Nemotron. Remove this line for models without a thinking switch.
LLM_ENABLE_THINKING=false

PERSONA_FILE=personas/relic.yaml
USER_NAME=choom
DATA_DIR=./data
HISTORY_LIMIT=20

# Voice mode (python -m relic --voice; needs: pip install -e ".[voice]")
# PIPER_MODEL=voices/en_US-lessac-medium.onnx
# WAKE_PHRASE=hey relic
# WHISPER_MODEL=small.en
# MIC_THRESHOLD=0.015
